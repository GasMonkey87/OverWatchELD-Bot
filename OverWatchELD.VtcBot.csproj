<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OverWatchELD.VtcBot</AssemblyName>
    <StartupObject>OverWatchELD.VtcBot.Program</StartupObject>

    <!-- Prevent nested/example projects from being compiled into the VtcBot app on Railway/Linux. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);OverWatchELD.Hub/**;OverWatchELD.Hub\**;Program_SplitExample.cs</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude the separate Hub sample project. Its Program.cs uses top-level statements and breaks this app when included. -->
    <Compile Remove="OverWatchELD.Hub/**/*.cs" />
    <Compile Remove="OverWatchELD.Hub\**\*.cs" />
    <None Remove="OverWatchELD.Hub/**" />
    <None Remove="OverWatchELD.Hub\**" />
    <Content Remove="OverWatchELD.Hub/**" />
    <Content Remove="OverWatchELD.Hub\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude old split/example Program file so only Program.cs + partial Program.* files compile. -->
    <Compile Remove="Program_SplitExample.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.16.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>

</Project>
